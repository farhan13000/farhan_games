# Leave the defaults for local development: Vite proxies /api and /socket.io to the server.
VITE_API_BASE_URL=/api
# Empty = same origin as the page (via the dev proxy or a reverse proxy in production).
VITE_SOCKET_URL=
# Where the dev proxy forwards requests.
VITE_DEV_PROXY_TARGET=http://localhost:5000
# Optional product name override.
VITE_APP_NAME=TicTac Arena

# Production example with API on a different host:
# VITE_API_BASE_URL=https://api.your-domain.com/api
# VITE_SOCKET_URL=https://api.your-domain.com
