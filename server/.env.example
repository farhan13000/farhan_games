# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (CORS + Socket.IO).
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Number of reverse proxies in front of the app (for correct client IPs / rate limits).
TRUST_PROXY=0

# --- Database --------------------------------------------------------------
# Local:   mongodb://127.0.0.1:27017/tictac_arena  (see docker-compose.yml)
# Atlas:   mongodb+srv://<user>:<password>@<cluster>/tictac_arena?retryWrites=true&w=majority
# Dev without MongoDB installed: MONGODB_URI=memory  (ephemeral; not allowed in production)
MONGODB_URI=mongodb://127.0.0.1:27017/tictac_arena

# --- Anonymous player sessions (no accounts) -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
SESSION_SECRET=replace_with_a_different_long_random_secret_32_chars
SESSION_TTL_DAYS=7
# lax for same-site deployments; none (+ COOKIE_SECURE=true) when client and API are on different sites.
COOKIE_SAMESITE=lax
# Defaults to true in production.
# COOKIE_SECURE=true

# --- Rooms -----------------------------------------------------------------
ROOM_WAITING_TTL_MINUTES=30
ROOM_IDLE_TTL_MINUTES=120
PLAYER_RECONNECT_GRACE_SECONDS=90
ROOM_SWEEP_INTERVAL_SECONDS=10
ENDED_ROOM_RETENTION_DAYS=7

# --- Features --------------------------------------------------------------
CHAT_ENABLED=true
RATE_LIMIT_ENABLED=true
